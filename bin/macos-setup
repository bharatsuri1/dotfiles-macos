#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
readonly LIB_DIR="$REPO_ROOT/lib/macos-setup"

for module in \
  common \
  homebrew \
  macos-defaults \
  shell-tools \
  shell \
  config \
  mise \
  npm-tools \
  nvim \
  vscode \
  yazi \
  herdr \
  status; do
  # shellcheck source=/dev/null
  source "$LIB_DIR/$module.sh"
done
unset module

usage() {
  cat <<'USAGE'
Usage: macos-setup [--dry-run] COMMAND

Commands:
  status         Report installed and managed state
  apply          Run every setup phase in dependency order
  homebrew       Install Homebrew if needed, then run the managed Brewfile
  macos-defaults Apply reviewed macOS defaults (keyboard, Finder, Dock, trackpad, screenshots, menu bar, general UI)
  shell-tools    Install pinned Zsh plugins directly without a plugin manager
  shell          Link the managed Zsh configuration
  config         Link the shared tool configuration (Starship, bat, tmux, Sesh, Atuin, Ghostty)
  mise           Install Node.js globally via mise
  npm-tools      Install global npm CLI tools (pnpm, opencode, codex, pi-coding-agent)
  nvim           Link the managed LazyVim Neovim configuration
  vscode         Link managed VS Code settings and install the reviewed extension allowlist
  yazi           Link the managed Yazi configuration with the Vesper flavor
  herdr          Link herdr config, then run the audited official herdr installer
USAGE
}

main() {
  while (($#)); do
    case "$1" in
      --dry-run) DRY_RUN=true; shift ;;
      --help|-h) usage; return ;;
      --) shift; break ;;
      -*) die "unknown option: $1" ;;
      *) break ;;
    esac
  done

  local command="${1:-apply}"
  (($# <= 1)) || die 'only one command may be supplied'
  require_macos

  case "$command" in
    status) show_status ;;
    apply)
      install_homebrew
      install_macos_defaults
      install_shell_tools
      install_shell
      install_config
      install_mise
      install_npm_tools
      install_nvim
      install_vscode
      install_yazi
      install_herdr
      ;;
    homebrew) install_homebrew ;;
    macos-defaults) install_macos_defaults ;;
    shell-tools) install_shell_tools ;;
    shell) install_shell ;;
    config) install_config ;;
    mise) install_mise ;;
    npm-tools) install_npm_tools ;;
    nvim) install_nvim ;;
    vscode) install_vscode ;;
    yazi) install_yazi ;;
    herdr) install_herdr ;;
    *) usage >&2; die "unknown command: $command" ;;
  esac
}

main "$@"
