#!/usr/bin/env bash
# Link this into ~/.local/bin and run `macos-update` to pull the latest
# dotfiles, re-run the setup from inside the repo, then upgrade Brewfile packages.
set -Eeuo pipefail

readonly REPOSITORY_URL="${DOTFILES_MACOS_REPOSITORY_URL:-https://github.com/bharatsuri1/dotfiles-macos.git}"
readonly INSTALL_ROOT="${DOTFILES_MACOS_INSTALL_ROOT:-$HOME/.local/share/dotfiles-macos}"

log() {
  printf '==> %s\n' "$*"
}

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

if [[ -d "$INSTALL_ROOT/.git" ]]; then
  log "updating existing checkout at $INSTALL_ROOT"
  current_branch="$(git -C "$INSTALL_ROOT" symbolic-ref --quiet --short HEAD)" ||
    die "$INSTALL_ROOT has a detached HEAD; check out main before running macos-update"
  [[ "$current_branch" == main ]] ||
    die "$INSTALL_ROOT is on branch $current_branch; check out main before running macos-update"
  git -C "$INSTALL_ROOT" pull --ff-only origin main
elif [[ -e "$INSTALL_ROOT" ]]; then
  die "$INSTALL_ROOT exists but is not a Git checkout; move it aside or set DOTFILES_MACOS_INSTALL_ROOT"
else
  log "cloning dotfiles-macos into $INSTALL_ROOT"
  mkdir -p "$(dirname -- "$INSTALL_ROOT")"
  git clone "$REPOSITORY_URL" "$INSTALL_ROOT"
fi

log 'running the macOS setup from the repo'
DOTFILES_MACOS_ASSUME_YES=1 "$INSTALL_ROOT/bin/macos-setup" apply

# shellcheck source=/dev/null
source "$INSTALL_ROOT/lib/macos-setup/homebrew.sh"
ensure_brew_on_path
command -v brew >/dev/null 2>&1 || die 'Homebrew is missing after setup'

upgrade_brewfile_group() {
  local kind="$1"
  local list
  local -a names=()
  local name
  list="$(brew bundle list "--${kind}" --file "$INSTALL_ROOT/Brewfile")"
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    names+=("$name")
  done <<< "$list"

  ((${#names[@]})) || return 0

  if [[ "$kind" == cask ]]; then
    log "upgrading ${#names[@]} Homebrew casks from the Brewfile"
    brew upgrade -y --cask "${names[@]}"
  else
    log "upgrading ${#names[@]} Homebrew formulae from the Brewfile"
    brew upgrade -y "${names[@]}"
  fi
}

log 'updating Homebrew'
brew update
upgrade_brewfile_group formula
upgrade_brewfile_group cask

log 'all updates complete'
